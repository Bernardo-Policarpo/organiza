# ###########################################################
# Organiza$ - Arquivo de Exemplo de Variáveis de Ambiente
# ###########################################################

# --- BACKEND CONFIGURATIONS ---

# Configurações do Banco de Dados MySQL
DB_URL=jdbc:mysql://localhost:3306/organiza_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=password

# Chave Secreta para JWT (JSON Web Token)
# Deve ser uma string longa e complexa, com no mínimo 32 caracteres.
JWT_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres


# --- FRONTEND CONFIGURATIONS ---

# URL base da API do Backend (consumida pelo Vite)
VITE_API_BASE_URL=http://localhost:8080/api
